#!/command/with-contenv bash
set -euo pipefail
umask 077
# Outside CI the Convex CLI reports to Sentry, and where that host is slow or blocked each command
# waits minutes for it on exit. A self-hosted install sends nothing anyway.
export CI=1
# `convex deploy` also asks version.convex.dev for news, with no timeout; a slow link held one start
# for 26 s. A refused loopback port fails that fetch at once, so a start never waits on the internet.
export CONVEX_VERSION_API_ORIGIN=http://127.0.0.1:9

log() { echo "[init] $*" >&2; }

public_url="${MEDIA_BASE_URL%/}"
puid="${PUID:-1000}"
pgid="${PGID:-1000}"

if ! [[ "$puid" =~ ^[0-9]+$ && "$pgid" =~ ^[0-9]+$ ]] || [ "$puid" = 0 ] || [ "$pgid" = 0 ]; then
  log "PUID and PGID must be numeric and not 0 (root); got PUID=$puid PGID=$pgid"
  exit 1
fi
for reserved in convex caddy; do
  if [ "$puid" = "$(id -u "$reserved")" ] || [ "$pgid" = "$(id -g "$reserved")" ]; then
    log "PUID and PGID may not be $(id -u "$reserved"), which the $reserved service uses; got PUID=$puid PGID=$pgid"
    exit 1
  fi
done

# At most seven significant digits, so the arithmetic below never wraps a huge number into range.
if [ -n "${LOG_MAX_MB:-}" ] &&
  ! [[ "$LOG_MAX_MB" =~ ^0*[0-9]{1,7}$ && "$((10#$LOG_MAX_MB))" -ge 8 && "$((10#$LOG_MAX_MB))" -le 1048576 ]]; then
  log "LOG_MAX_MB must be a whole number of MiB from 8 to 1048576; got LOG_MAX_MB=$LOG_MAX_MB"
  exit 1
fi

[ "$(id -g movies)" = "$pgid" ] || groupmod --non-unique --gid "$pgid" movies
[ "$(id -u movies)" = "$puid" ] || usermod --non-unique --uid "$puid" --gid "$pgid" movies

for node in /dev/dri/renderD*; do
  [ -e "$node" ] || continue
  gid="$(stat -c %g "$node")"
  getent group "$gid" >/dev/null || groupadd --gid "$gid" "render$gid"
  usermod -a -G "$(getent group "$gid" | cut -d: -f1)" movies
done

# The core's nightly and upgrade backups sit beside its database. The media service takes them, so
# they are its own; /data/movies keeps its caches and the image CLI's logins.
install -d -m 700 /data/core/secrets /data/movies/config
install -d -m 700 -o movies -g movies /data/core/backups /data/movies/media /transcode
find /data/core/backups /data/movies/media /transcode \( \! -user movies -o \! -group movies \) \
  -exec chown -h movies:movies {} +

convex() { (cd /app/platform && node node_modules/convex/bin/main.js "$@"); }

log "waiting for the core's Convex backend"
for _ in $(seq 1 120); do
  curl -fsS http://127.0.0.1:3210/version >/dev/null 2>&1 && break
  sleep 1
done
curl -fsS http://127.0.0.1:3210/version >/dev/null || { log "the core's Convex backend did not answer"; exit 1; }

admin_key="$(LD_PRELOAD=/app/convex/argv-secret.so ARGV_SECRET_FILE=/data/core/secrets/instance_secret \
  /app/convex/generate_key core @ARGV_SECRET_FILE | tail -n 1)"
export CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210 CONVEX_SELF_HOSTED_ADMIN_KEY="$admin_key"

version="$(node -p "require('/app/platform/package.json').version")+$(cat /app/platform/.functions-hash)"
if [ -s /data/core/version ] && [ "$(cat /data/core/version)" != "$version" ] &&
  [ "$(cat /data/core/upgrade-backup 2>/dev/null)" != "$version" ]; then
  stamp="$(date -u +%Y-%m-%dT%H-%M-%S-000Z)"
  backup="/data/core/backups/core-manual-$stamp.zip"
  log "upgrading the core from $(cat /data/core/version) to $version; backing up to $backup first"
  convex export --include-file-storage --path "/data/core/backups/.partial-core-manual-$stamp.zip"
  mv "/data/core/backups/.partial-core-manual-$stamp.zip" "$backup"
  chown movies:movies "$backup"
  printf '%s\n' "$version" >/data/core/upgrade-backup
fi

log "deploying the core's functions ($version)"
convex deploy --yes --codegen disable --typecheck disable
log "configuring the core deployment"
(cd /app/platform && node scripts/configure.mjs)
convex run core/schemaMigrations:run >/dev/null
printf '%s\n' "$version" >/data/core/version
rm -f /data/core/upgrade-backup

# The media service signs in to the core as its own service principal, created on the first start.
# Its key is shown once, so it is kept in a root-only file that later starts reuse; without the
# file, the principal gets a new key, and the first use of that key retires the old ones.
service_id_file=/data/core/secrets/media-service-id
service_key_file=/data/core/secrets/media-service-key
create_service() {
  log "creating the media server's service principal"
  convex run core/accounts/host:createService '{"name":"media server"}' |
    node -e 'let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => process.stdout.write(JSON.parse(s)))' \
      >"$service_id_file.partial"
  mv "$service_id_file.partial" "$service_id_file"
}
# Reads the key from the CLI's output on stdin, so it never reaches a command line or the log.
issue_service_key() {
  convex run core/auth/apiKeys:issueServiceKey "{\"serviceId\":\"$(cat "$service_id_file")\"}" |
    node -e 'let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => process.stdout.write(JSON.parse(s).key))' \
      >"$service_key_file.partial"
}
if ! [ -s "$service_key_file" ]; then
  [ -s "$service_id_file" ] || create_service
  log "issuing the media server's service key"
  # A restored database may not hold the recorded principal; then the server gets a new one.
  if ! issue_service_key; then
    create_service
    issue_service_key
  fi
  mv "$service_key_file.partial" "$service_key_file"
fi
media_service_api_key="$(cat "$service_key_file")"
media_ticket_keys="$(convex env get MEDIA_TICKET_KEYS)"
[ -n "$media_ticket_keys" ] || { log "the core deployment has no MEDIA_TICKET_KEYS"; exit 1; }

umask 022
install -d -m 755 /run/media
node /app/media/scripts/configure-web.ts --from /app/account --to /run/media/account \
  --convex-url "$public_url/convex"
node /app/media/scripts/configure-web.ts --from /app/web --to /run/media/web \
  --convex-url "$public_url/convex"

umask 077
install -d -m 755 /run/movies
env_file=/run/movies/media.env
install -m 600 -o movies -g movies /dev/null "$env_file"
setting() { [ -z "$2" ] || printf '%s=%s\n' "$1" "$2" >>"$env_file"; }
setting HOST 127.0.0.1
setting PORT 4300
setting MEDIA_BASE_URL "$public_url"
setting CONVEX_URL http://127.0.0.1:3210
setting CONVEX_PUBLIC_URL "$public_url/convex"
setting MEDIA_SERVICE_API_KEY "$media_service_api_key"
setting MEDIA_TICKET_KEYS "$media_ticket_keys"
setting CONVEX_SELF_HOSTED_ADMIN_KEY "$admin_key"
setting CONVEX_BACKEND_DIR /app/platform
setting DATA_DIR /data/movies/media
setting BACKUP_DIR /data/core/backups
setting TRANSCODE_DIR /transcode
setting WEB_DIST_DIR /run/media/web
setting LIBRARY_ROOTS "${LIBRARY_ROOTS:-/media}"
optional_settings=(
  BACKUP_RETENTION_DAYS
  TMDB_API_KEY
  OMDB_API_KEY
  OTEL_EXPORTER_OTLP_ENDPOINT
  HARDWARE_ACCELERATION
  QSV_DEVICE
  VAAPI_DEVICE
  LIBVA_DRIVER_NAME
  MAX_CONCURRENT_TRANSCODES
  MAX_CONCURRENT_REMUXES
  STREAM_IDLE_SECONDS
  STREAM_BUFFER_AHEAD_SECONDS
  MIN_FREE_TRANSCODE_MB
  LIBRARY_RECONCILE_MINUTES
  TRICKPLAY
  TRICKPLAY_INTERVAL_SECONDS
  TRICKPLAY_CONCURRENCY
  LIBRARY_WATCH
  LIBRARY_POLL_SECONDS
  PROBE_TIMEOUT_SECONDS
  FILE_SCAN_TIMEOUT_SECONDS
  CACHE_MAX_MB
  LOG_LEVEL
  LOG_RETENTION_DAYS
  LOG_MAX_MB
)
for name in "${optional_settings[@]}"; do
  setting "$name" "${!name:-}"
done

log "ready at $public_url"
