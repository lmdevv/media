# Runtime configuration names. Never commit values.

# The core's Convex deployment (packages/platform: local, self-hosted, or cloud) and Convex Auth.
# The admin key also lets the media service back the core up and restore it.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
JWT_PRIVATE_KEY=
JWKS=

# The core's ticket key ring, which signs every byte ticket: the same value in the core deployment
# and the media service. Never sent to clients.
MEDIA_TICKET_KEYS=

# The media service's connection to the core: the URL it connects to, the URL clients use, and the
# service key the core issued it (core/auth/apiKeys:issueServiceKey)
CONVEX_URL=
CONVEX_PUBLIC_URL=
MEDIA_SERVICE_API_KEY=

# Client-reachable media endpoint
MEDIA_BASE_URL=

# Metadata plugin
TMDB_API_KEY=
# Optional: IMDb, Rotten Tomatoes, and Metacritic scores from OMDb (free tier is enough)
OMDB_API_KEY=

# Paths: approved library mounts (comma-separated), state, temporary HLS output, backups
LIBRARY_ROOTS=
DATA_DIR=
TRANSCODE_DIR=
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=
# The deployed @media/platform package, whose Convex CLI backs up and restores the core
CONVEX_BACKEND_DIR=

# Optional local OpenTelemetry collector
OTEL_EXPORTER_OTLP_ENDPOINT=

# The image's Caddy: proxies in front whose X-Forwarded-For names the client, space-separated CIDRs [none]
MEDIA_TRUSTED_PROXIES=

# Media service (optional; defaults in apps/media/README.md)
PORT=
HOST=
WEB_DIST_DIR=
MAX_CONCURRENT_TRANSCODES=
MAX_CONCURRENT_REMUXES=
HARDWARE_ACCELERATION=
QSV_DEVICE=
VAAPI_DEVICE=
LIBVA_DRIVER_NAME=
STREAM_IDLE_SECONDS=
STREAM_BUFFER_AHEAD_SECONDS=
MIN_FREE_TRANSCODE_MB=
LIBRARY_RECONCILE_MINUTES=
TRICKPLAY=
TRICKPLAY_INTERVAL_SECONDS=
TRICKPLAY_CONCURRENCY=
LIBRARY_WATCH=
LIBRARY_POLL_SECONDS=
PROBE_TIMEOUT_SECONDS=
FILE_SCAN_TIMEOUT_SECONDS=
CACHE_MAX_MB=
LOG_LEVEL=
LOG_RETENTION_DAYS=
LOG_MAX_MB=
FFMPEG_PATH=
FFPROBE_PATH=
