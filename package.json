{
  "name": "movies",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:web": "turbo run dev -F web --",
    "prepare": "effect-tsgo patch --typescript --oxlint && lefthook install",
    "typecheck": "turbo run typecheck && tsc --noEmit -p scripts",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --disable-nested-config --check",
    "test": "vitest run",
    "test:e2e": "turbo run test:e2e",
    "knip": "knip"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@media/config": "workspace:*",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "1.64.0",
    "@types/node": "catalog:",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "catalog:",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.3.4"
}
