{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["legacy/**", "tools/oxlint/**"],
  "ignoreDependencies": ["@effect/language-service"],
  "workspaces": {
    ".": {
      "entry": [".agents/skills/*/scripts/*.mjs", "scripts/*.ts"],
      "ignoreBinaries": ["ffmpeg"]
    },
    "apps/media": {
      "entry": ["src/main.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignoreBinaries": ["unshare"]
    },
    "apps/web-movies": {},
    "apps/web-account": {},
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/backend": {
      "typescript": {
        "config": ["convex/tsconfig.json"]
      }
    },
    "packages/platform": {
      "entry": ["commands/refs.ts"],
      "typescript": {
        "config": ["convex/tsconfig.json"]
      }
    },
    "packages/ui": {},
    "packages/sdk": {},
    "apps/cli": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    }
  }
}
