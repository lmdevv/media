# The core's Convex URL browsers use. scripts/dev-stack.sh writes it to .env.local; production
# images build with a placeholder that startup replaces with MEDIA_BASE_URL/convex.
VITE_PLATFORM_URL=
# Media service URL for artwork and media commands. Leave empty when the media service serves the app.
VITE_MEDIA_BASE_URL=
# The account client's dev server; this dev server passes every path outside /movies/ to it, so
# both clients share one origin and one sign-in.
ACCOUNT_DEV_URL=
