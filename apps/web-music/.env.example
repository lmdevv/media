# The core's Convex URL browsers use. scripts/dev-stack.sh writes it to .env.local; production
# images build with a placeholder that startup replaces with MEDIA_BASE_URL/convex.
VITE_PLATFORM_URL=
# Media service URL for streams and artwork. Leave empty when the app shares the media server's origin.
VITE_MEDIA_BASE_URL=
# Where this client signs in during development: the stack's sign-in boundary.
VITE_SIGN_IN_URL=
# This dev server's port.
MUSIC_PORT=
# The account client's dev server; this dev server passes every path outside /music/ to it, so
# both clients share one origin and one sign-in.
ACCOUNT_DEV_URL=
