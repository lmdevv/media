{
  "name": "@media/server",
  "version": "0.3.0",
  "private": true,
  "description": "Node + Effect HttpApi media service. Also serves the built web app.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.ts --watch",
    "build": "node scripts/build.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/generate-fixtures.ts",
    "timing": "MEDIA_TIMING=1 vitest run --root ../.. --silent=false apps/media/src/timing",
    "timing:hls": "MEDIA_TIMING=1 vitest run --root ../.. --silent=false apps/media/src/playback/hls-timing.test.ts",
    "test:stack": "MEDIA_STACK_TESTS=1 vitest run --root ../.. --no-file-parallelism apps/media/src/stack"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@xmldom/xmldom": "0.9.12",
    "effect": "catalog:",
    "music-metadata": "12.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@media/config": "workspace:*",
    "@media/contracts": "workspace:*",
    "@media/sdk": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.27.0",
    "fast-check": "4.10.2",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  }
}
